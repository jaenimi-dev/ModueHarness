# ==============================================================================
# ModueHarness Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your API keys:
#   cp .env.example .env
# ==============================================================================

# 1. Anthropic Claude (for 'claude' CLI and Claude Code)
# If using Claude Code with 'claude login' OAuth, API key may not be required.
ANTHROPIC_API_KEY=

# 2. OpenAI (for 'aider' or OpenAI-based CLI tools)
OPENAI_API_KEY=

# 3. Google Gemini / Antigravity (for 'agy' CLI or Google Generative AI)
GEMINI_API_KEY=

# 4. OpenRouter (for the built-in 'openrouter' agent adapter; needs: pip install 'modue-harness[openrouter]')
# 에이전트마다 api_key_env 로 다른 변수 이름을 지정할 수 있습니다.
OPENROUTER_API_KEY=

# 5. ModueHarness Custom Settings (Optional)
# MODUE_BLACKBOARD_DIR=blackboard
# MODUE_LOG_LEVEL=INFO
